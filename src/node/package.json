{
  "name": "@bend/demoparser",
  "version": "0.8.1",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "demoparser",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "ava": "^5.1.1",
    "jest": "^29.7.0"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "jest",
    "universal": "napi universal",
    "version": "napi version"
  },
  "optionalDependencies": {
    "@bend/demoparser-win32-x64-msvc": "0.8.1",
    "@bend/demoparser-darwin-x64": "0.8.1",
    "@bend/demoparser-linux-x64-gnu": "0.8.1"
  }
}